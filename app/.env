# LTA DATAMALL API Configuration
API_KEY=<>
API_BUS_URL="https://datamall2.mytransport.sg/ltaodataservice/v3/BusArrival?BusStopCode="
API_TRAIN_URL="https://datamall2.mytransport.sg/ltaodataservice/TrainServiceAlerts"

# Home Assistant Sleep Screen
HOME_ASSISTANT_API_URL = "http://homeassistant.local:8123"
HOME_ASSISTANT_SLEEP_URL = "http://homeassistant.local:10000/"
HOME_ASSISTANT_TOKEN = <>
HOME_ASSISTANT_WEATHER_ENTITY = weather.openweathermap
SLEEP_SCREEN_DASHBOARD = "dashboard-busauntiesleepdisplay"
SLEEP_SCREEN_EINK_MODE = "4"
SLEEP_SCREEN_ZOOM = "0.91"
SLEEP_SCREEN_FORMAT = "png"
SLEEP_SCREEN_WAIT = "5000"
SLEEP_SCREEN_THEME = "Graphite E-ink Lite"

# Bus Stop Configuration
BUS_STOP_CODE_A=<>
BUS_STOP_CODE_B=<>

A_HEADER=<>
B_HEADER=<>

# Display Timing
WAKE_HOUR=6
SLEEP_HOUR=9
WAKE_INTERVAL=60
SLEEP_INTERVAL=300 # 10 mins

# MQTT Configuration
MQTT_ENABLED=true
MQTT_BROKER=homeassistant.local # Your Home Assistant IP
MQTT_PORT=1883
MQTT_USERNAME=RaspberryPi-BA-user # Optional
MQTT_PASSWORD=neulussheim  # Optional
MQTT_TOPIC_REFRESH=eink/display/refresh
MQTT_TOPIC_STATUS=eink/display/status

# Debug & Logging
DEBUG_SKIP_TIME_CHECK=FALSE  # Skip time checks, always show display
LOG_LEVEL=INFO    # Options: DEBUG, INFO, WARNING, ERROR
